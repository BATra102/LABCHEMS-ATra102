# ====================================================================
# LABCHEM INVENTORY - SUPABASE ENVIRONMENT VARIABLES
# ====================================================================

# 1. Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon / Publishable Key (Public safe key for client-side queries & Realtime)
# Found in Supabase Dashboard -> Project Settings -> API -> Project API Keys (anon public key)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NOTE: NEVER put SUPABASE_SERVICE_ROLE_KEY here or anywhere in frontend!
